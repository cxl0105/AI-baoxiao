# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reimbursement

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Storage - Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=reimbursement-docs

# JWT / Auth
# ⚠️ 生产环境必填：JWT_SECRET 至少 16 位随机字符串，缺失则生产启动直接失败
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 🔴 安全必填：平台管理员初始化密码（运行 platform_seed 前必须设置，≥8 位）
PLATFORM_ADMIN_PASSWORD=

# API Keys
OCR_API_KEY=

# --------------------------
# AI OCR 后端代理模式（推荐）
#   前端只需上传文件，API Key 只保存在服务器，不暴露给浏览器。
#   系统设置 → AI OCR 大模型 → 调用模式选「通过后端代理」即可生效。
#   Base URL / Model / API Key 三选一必填；三家平台示例：
#     智谱 GLM-4V-plus:
#       OCR_PROXY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#       OCR_PROXY_MODEL=glm-4v-plus
#     阿里千问 Qwen-VL-Max (兼容模式):
#       OCR_PROXY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#       OCR_PROXY_MODEL=qwen-vl-max
#     OpenAI GPT-4o:
#       OCR_PROXY_BASE_URL=https://api.openai.com/v1
#       OCR_PROXY_MODEL=gpt-4o
# --------------------------
OCR_PROXY_BASE_URL=
OCR_PROXY_API_KEY=
OCR_PROXY_MODEL=
# 超时（毫秒），默认 60000
OCR_PROXY_TIMEOUT_MS=60000
# 温度，视觉识别建议 0.0~0.2，默认 0.1
OCR_PROXY_TEMPERATURE=0.1
# 自定义系统提示词（留空使用内置发票识别专用 prompt）
OCR_PROXY_SYSTEM_PROMPT=
# 后端最大请求体（部署到反向代理时也要同步配置 client_max_body_size）
#   单张发票图片建议 10MB；如需识别 PDF 请提到 50MB 以上
